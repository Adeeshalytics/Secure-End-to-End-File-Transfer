# ─────────────────────────────────────────────────────────────────────────────
# SecureEval — environment variable reference
# Copy the relevant section into the correct file (see path comments).
# Neither file is committed to git — recreate them after a fresh clone.
# ─────────────────────────────────────────────────────────────────────────────

# ── backend/.env ─────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=dev-only-replace-with-managed-secret-key-at-least-32-bytes
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — matches the Docker Compose service in docker-compose.yml
DATABASE_URL=postgres://secure_eval:change-me-local-only@localhost:5432/secure_academic_eval

# CORS / CSRF — must match the frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# JWT token lifetimes
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

SECURE_PROXY_SSL_HEADER=

# ── frontend/.env.local ───────────────────────────────────────────────────────
# Django runs on 8001 to avoid conflict with other local services on 8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_APP_NAME=Secure Academic Evaluation
